# ---------------------------------------------------------------------------
# wheretowfc - production environment template
# ---------------------------------------------------------------------------
#
# Copy it to the repository root as `.env` and fill it in:
#
#   cp deploy/.env.production.example .env
#   chmod 600 .env
#
# `deploy/compose.prod.yaml` reads this single file twice: as the container
# environment of the api/worker/db containers (`env_file: ../.env`) and as the
# source of the Postgres bootstrap credentials. The API itself also loads a
# `.env` if one is present next to the working directory, but in the container
# every value below arrives as a real environment variable.
#
# NEVER commit the filled-in file. `.env` is gitignored; this template is not.
# Placeholders like <...> or example.com MUST be replaced before going live.
# ---------------------------------------------------------------------------


# --- HTTP surface of the API container -------------------------------------

# Port the API listens on inside the container. Caddy proxies api.<domain> to
# this port over the compose network; it is never published to the host.
PORT=8080

# Comma-separated browser-origin allowlist for CORS (scheme + host + optional
# port, no trailing slash, no spaces needed - whitespace is trimmed).
# It MUST contain the exact origins the admin and public SPAs are served from,
# otherwise the browser refuses both the request and the session cookie:
#   - the two Cloudflare Pages production URLs, and
#   - any custom domain you attach to those Pages projects.
# Custom domains are the reliable option for cookie auth: keep the admin app and
# the API on the same registrable domain (both under example.com) so the session
# cookie is first-party and survives third-party-cookie blocking.
CORS_ORIGIN=https://admin.example.com,https://example.com,https://wfc-admin.pages.dev,https://wfc-web.pages.dev


# --- Postgres --------------------------------------------------------------
# Read by the `db` service (postgis/postgis) to initialise the cluster on the
# very first start of an empty volume, and by the API through DATABASE_URL.
# POSTGRES_PASSWORD must match the password inside DATABASE_URL below.

POSTGRES_DB=wheretowfc
POSTGRES_USER=wheretowfc
# Generate with: openssl rand -base64 32   (never reuse the dev password)
POSTGRES_PASSWORD=<strong-random-password>

# The API talks to the db container over the compose network, hence host `db`
# and port 5432 (no host port is published). sslmode=disable is correct here:
# the connection never leaves the Docker network.
DATABASE_URL=postgres://wheretowfc:<strong-random-password>@db:5432/wheretowfc?sslmode=disable


# --- Redis -----------------------------------------------------------------
# Host is the compose service name. Leave REDIS_PASSWORD empty unless you also
# start Redis with requirepass (not configured by deploy/compose.prod.yaml);
# with a password set here and no requirepass, the API and worker fail to boot.

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
INGESTION_QUEUE=ingestion
# Concurrency of the asynq worker. Keep at 4 unless the VPS is large.
INGESTION_WORKERS=4


# --- Query interpretation (TypeSafe) ---------------------------------------
# Empty key means the API falls back to its built-in deterministic interpreter.

TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest


# --- Ingestion: source discovery (Exa) -------------------------------------
# Empty EXA_API_KEY disables Exa discovery; the worker still runs enrichment
# from manually supplied sources.

EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_MAX_RESULTS=5


# --- Ingestion: structured extraction (OpenRouter) -------------------------
# Both OPENROUTER_API_KEY and OPENROUTER_MODEL must be set to enable it.
# OPENROUTER_SITE_URL/APP_NAME are attribution headers - set SITE_URL to the
# public web origin so OpenRouter can attribute the traffic.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=Where to WFC ingestion
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_INPUT_CHARS=24000
OPENROUTER_MAX_OUTPUT_TOKENS=5000


# --- Ingestion: Google Places identity resolution --------------------------
# Empty GOOGLE_PLACES_API_KEY disables Place Details lookups (uncached admin
# review display and stable Place ID resolution).

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
GOOGLE_PLACES_LANGUAGE_CODE=id
GOOGLE_PLACES_REGION_CODE=ID
GOOGLE_PLACES_DEFAULT_AREA="Jakarta, Indonesia"
GOOGLE_PLACES_TIMEOUT_SECONDS=12


# --- Admin authentication --------------------------------------------------
# Magic-link sign-in for the admin SPA. Sign-in links contain a one-time token,
# so ADMIN_APP_URL must be the real admin origin over HTTPS in production.

# Origin the admin SPA is served from. Used to build the sign-in link that is
# emailed and to restrict post-sign-in redirects. An https:// value also makes
# the session cookie `Secure`.
ADMIN_APP_URL=https://admin.example.com
# Lifetime of an admin session, in hours. Default: 720 (30 days). Must be >= 1.
ADMIN_SESSION_TTL_HOURS=12
# Cookie domain for the admin session cookie. Use ".example.com" (a leading dot
# is accepted; "example.com" behaves the same) to share the cookie between the
# admin app and api.<domain>.
# Leave EMPTY when the admin app and the API live on unrelated domains
# (e.g. *.pages.dev) - the cookie is then host-only, and you must set
# ADMIN_COOKIE_SAMESITE=none for the browser to send it cross-site.
ADMIN_COOKIE_DOMAIN=.example.com
# SameSite policy of the session cookie: lax (default), strict or none.
# Anything unrecognised falls back to lax.
# Use `none` only for genuinely cross-site setups (different registrable
# domains); it forces the cookie to be Secure and is refused by browsers that
# block third-party cookies. Prefer custom domains + `lax`.
ADMIN_COOKIE_SAMESITE=lax


# --- Outbound email (magic links) ------------------------------------------
# PRODUCTION MUST SET SMTP_HOST. When SMTP_HOST is empty the API logs a startup
# warning and prints sign-in links to its own log instead of emailing them;
# that is a development convenience, never leave it on in production.

SMTP_HOST=
# 587 (STARTTLS) is the common default; 465 implies implicit TLS automatically.
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Envelope sender, e.g. "Where to WFC <no-reply@example.com>". Required whenever
# SMTP_HOST is set; if empty it falls back to SMTP_USERNAME. It must be an
# address your provider allows you to send as, otherwise magic-link mail is
# rejected or spam-filed.
SMTP_FROM=Where to WFC <no-reply@example.com>
# Transport: `starttls` (default) or `implicit`. `implicit` is also selected
# automatically when SMTP_PORT=465. Anything else is treated as STARTTLS.
# `none` sends unencrypted: only for a local relay on a private network, never
# for a public SMTP host.
SMTP_TLS=starttls
